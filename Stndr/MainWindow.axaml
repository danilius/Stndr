<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Stndr"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Stndr.MainWindow"
        Title="Stndr"
        Icon="/Assets/AppIcon.ico"
        WindowState="Maximized"
        Background="{DynamicResource Theme.Window}">
    <Window.Styles>
        <Style Selector="TabControl#CenterTabs">
            <Setter Property="Background" Value="{DynamicResource Theme.Window}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="TabControl#CenterTabs TabItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.tab-close-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.tab-close-button:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.tab-close-button:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.reader-list">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:current">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:focus">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource Theme.Selection}" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Selection}" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:current /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Selection}" />
        </Style>

        <Style Selector="ListBox.reader-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Selection}" />
        </Style>

        <Style Selector="Button.reader-nav-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.reader-nav-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.Hover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.commentary-source-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.commentary-source-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        </Style>

        <Style Selector="Button.commentary-source-row:pressed">
            <Setter Property="Background" Value="{DynamicResource Theme.Hover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        </Style>

        <Style Selector="Button.commentary-source-row.selected">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceAlt}" />
        </Style>
    </Window.Styles>

    <Grid x:Name="LayoutRoot"
          RowDefinitions="Auto,Auto,Auto,*"
          ColumnDefinitions="250,8,*,8,320"
          Margin="12,0,12,12">

        <Grid Grid.Row="0" Grid.ColumnSpan="5" ColumnDefinitions="Auto,*,Auto" Margin="4,4,4,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="main-function" Click="OpenDictionaryClicked"><StackPanel Orientation="Horizontal" Spacing="10"><local:ThemeIcon Kind="search"/><TextBlock local:UiTheme.Role="MainButton" Text="Dictionary"/></StackPanel></Button>
                <Button Classes="main-function" Click="OpenAdvancedSearchClicked"><StackPanel Orientation="Horizontal" Spacing="10"><local:ThemeIcon Kind="search"/><TextBlock local:UiTheme.Role="MainButton" Text="Advanced Search"/></StackPanel></Button>
                <Button Classes="main-function" Click="OpenSettingsClicked"><StackPanel Orientation="Horizontal" Spacing="10"><local:ThemeIcon Kind="settings"/><TextBlock local:UiTheme.Role="MainButton" Text="Settings"/></StackPanel></Button>
                <Button Classes="main-function" Click="OpenBookmarksClicked"><StackPanel Orientation="Horizontal" Spacing="10"><local:ThemeIcon Kind="bookmark"/><TextBlock local:UiTheme.Role="MainButton" Text="Bookmarks"/></StackPanel></Button>
                <Button Classes="main-function" Click="OpenHighlightsClicked"><StackPanel Orientation="Horizontal" Spacing="10"><local:ThemeIcon Kind="highlight"/><TextBlock local:UiTheme.Role="MainButton" Text="Highlights"/></StackPanel></Button>
                <Button Classes="main-function" Click="OpenNotesClicked"><StackPanel Orientation="Horizontal" Spacing="10"><local:ThemeIcon Kind="note"/><TextBlock local:UiTheme.Role="MainButton" Text="Notes"/></StackPanel></Button>
            </StackPanel>
            <TextBox x:Name="GlobalSearchBox" Grid.Column="2" Width="320" Margin="16,0,0,0" VerticalAlignment="Center" PlaceholderText="Search across texts…   Ctrl K" KeyDown="GlobalSearchKeyDown"/>
        </Grid>

        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Grid.ColumnSpan="5"
                IsVisible="False"
                Background="{DynamicResource Theme.InfoBackground}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Theme.Border}"
                Padding="8,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            Spacing="8">
                    <Button x:Name="UpdateBannerActionButton"
                            MinWidth="96"
                            Click="UpdateBannerActionClicked" />
                    <Button x:Name="UpdateBannerDismissButton"
                            Content="Later"
                            MinWidth="64"
                            Click="UpdateBannerDismissClicked" />
                </StackPanel>
                <TextBlock x:Name="UpdateBannerMessage"
                           Text="An update is available."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Border x:Name="LibraryUpdateBanner"
                Grid.Row="2"
                Grid.ColumnSpan="5"
                IsVisible="False"
                Background="{DynamicResource Theme.SuccessBackground}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Theme.Border}"
                Padding="8,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="LibraryUpdateBannerActionButton"
                            Content="Update"
                            MinWidth="96"
                            Click="LibraryUpdateBannerActionClicked" />
                    <Button x:Name="LibraryUpdateBannerDismissButton"
                            Content="Later"
                            MinWidth="64"
                            Click="LibraryUpdateBannerDismissClicked" />
                    <Button x:Name="LibraryUpdateBannerCancelButton"
                            Content="Cancel"
                            MinWidth="80"
                            IsVisible="False"
                            Click="LibraryUpdateBannerCancelClicked" />
                </StackPanel>
                <StackPanel Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="LibraryUpdateBannerMessage"
                               Text="A Sefaria library update is available."
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <ProgressBar x:Name="LibraryUpdateBannerProgress"
                                 Minimum="0"
                                 Maximum="1"
                                 Height="6"
                                 IsVisible="False"
                                 IsIndeterminate="True" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Grid.Column="0" Classes="workspace-panel">
            <Grid RowDefinitions="*,Auto">
                <Grid x:Name="LeftPanelBody" Margin="10,4">

                        <Expander IsExpanded="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" Classes="library-expander">
                            <Expander.Header><StackPanel Orientation="Horizontal" Spacing="10"><local:ThemeIcon Kind="book"/><TextBlock local:UiTheme.Role="ExpanderHeader" Text="Library"/></StackPanel></Expander.Header>
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                                <Grid ColumnDefinitions="*,30">
                                    <TextBox x:Name="LeftPanelSearchBox" PlaceholderText="Find a text…" MinWidth="0"/>
                                    <Button x:Name="LeftPanelSearchButton" Grid.Column="1" Click="ToggleInstalledBooksSearchClicked" Padding="4" ToolTip.Tip="Find an installed book"><local:ThemeIcon Kind="search" Width="17" Height="17"/></Button>
                                </Grid>
                                <Border Grid.Row="1" x:Name="LeftPanelSearchSuggestionsContainer" IsVisible="False" Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4">
                                    <ListBox x:Name="LeftPanelSearchSuggestions" SelectionMode="Single" MaxHeight="200" Background="Transparent" BorderThickness="0"/>
                                </Border>
                                <TreeView Grid.Row="2" x:Name="InstalledBooksTree" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionChanged="OnInstalledBookSelectionChanged"/>
                            </Grid>
                        </Expander>

                </Grid>
                        <Expander x:Name="LeftSavedSearches" Grid.Row="1" Margin="10,0,10,4" IsExpanded="True" HorizontalAlignment="Stretch">
                            <Expander.Header><StackPanel Orientation="Horizontal" Spacing="10"><local:ThemeIcon Kind="search"/><TextBlock local:UiTheme.Role="ExpanderHeader" Text="Saved Searches"/></StackPanel></Expander.Header>
                            <ListBox x:Name="SavedSearchesList" MinHeight="0" MaxHeight="240" SelectionChanged="OnSavedSearchSelectionChanged"/>
                        </Expander>
            </Grid>
        </Border>

        <GridSplitter x:Name="LeftSplitter"
                      Grid.Row="3"
                      Grid.Column="1"
                      Background="Transparent"
                      Width="8"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" />

        <Grid Grid.Row="3"
              Grid.Column="2"
              Margin="0"
              RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <ScrollViewer x:Name="CenterTabsScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <TabControl x:Name="CenterTabs">
                        <TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></TabControl.ItemsPanel>
                    </TabControl>
                </ScrollViewer>
                <Button x:Name="TabOverflowButton" Grid.Column="1" IsVisible="False" Width="30" Height="30" MinWidth="0" MinHeight="0" Padding="6" Margin="4,0,0,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" ToolTip.Tip="All open tabs"><local:ThemeIcon Kind="chevron-down" Width="16" Height="16"/></Button>
            </Grid>
            <Grid x:Name="CenterTabContentHost"
                  Grid.Row="1"
                  Background="{DynamicResource Theme.Surface}" />
        </Grid>

        <GridSplitter x:Name="RightSplitter"
                      Grid.Row="3"
                      Grid.Column="3"
                      Background="Transparent"
                      Width="8"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" />

        <Border Grid.Row="3" Grid.Column="4" Classes="workspace-panel">
            <Grid RowDefinitions="Auto,*">
                <TextBlock x:Name="RightPanelTitle" IsVisible="False" Text="Tools"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RightPanelBody" Margin="10,4" HorizontalAlignment="Stretch" Spacing="8">
                        <TextBlock Text="Open a text to see reader tools." TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Button Grid.Row="3" Grid.Column="1" ZIndex="1" Width="12" Height="34" MinWidth="0" MinHeight="0" Padding="0" Background="{DynamicResource Theme.Window}" BorderThickness="0" VerticalAlignment="Center" Click="ToggleLeftPanel" ToolTip.Tip="Toggle Library (Ctrl+B)"><local:ThemeIcon x:Name="LeftSplitterArrow" Kind="back" Width="10" Height="14"/></Button>
        <Button Grid.Row="3" Grid.Column="3" ZIndex="1" Width="12" Height="34" MinWidth="0" MinHeight="0" Padding="0" Background="{DynamicResource Theme.Window}" BorderThickness="0" VerticalAlignment="Center" Click="ToggleRightPanel" ToolTip.Tip="Toggle tools (Ctrl+Shift+B)"><local:ThemeIcon x:Name="RightSplitterArrow" Kind="chevron" Width="10" Height="14"/></Button>

        <Canvas x:Name="FloatingOverlayCanvas"
                Grid.Row="3"
                Grid.ColumnSpan="5"
                ZIndex="200">
            <Border x:Name="DictionaryPopup"
                    IsVisible="False"
                    Width="280"
                    MinHeight="150"
                    Background="{DynamicResource Theme.SurfaceAlt}"
                    BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Canvas.Left="360"
                    Canvas.Top="140"
                    BoxShadow="{DynamicResource Theme.PopupShadow}">
                <StackPanel Spacing="8"
                            Margin="10">
                    <Border x:Name="DictionaryPopupDragHandle"
                            Background="Transparent"
                            Padding="0">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="6">
                            <TextBlock Text="Dictionary"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="DictionaryPopupDockButton"
                                    Grid.Column="1"
                                    Content="Dock"
                                    Padding="8,2"
                                    MinHeight="26" />
                            <Button x:Name="DictionaryPopupCloseButton"
                                    Grid.Column="2"
                                    Content="x"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0" />
                        </Grid>
                    </Border>
                    <StackPanel Spacing="8"
                                Margin="0">
                        <TextBlock x:Name="DictionaryPopupWord" local:UiTheme.Role="DictionaryHeadword"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DictionaryPopupReference" local:UiTheme.Role="Reference"
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.Muted}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DictionaryPopupStatus"
                                   Foreground="{DynamicResource Theme.Muted}"
                                   TextWrapping="Wrap"
                                   Text="Dictionary lookup is not connected yet." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
